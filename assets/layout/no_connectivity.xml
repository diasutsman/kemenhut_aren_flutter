<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/connectView"
    android:elevation="10dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/txtConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/card_margin_side"
        android:paddingBottom="@dimen/card_margin_side"
        android:paddingLeft="@dimen/card_margin_side"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:background="@color/colorRed"
        android:textSize="@dimen/label_value_size"
        android:layout_gravity="bottom"
        android:text="@string/NoConnectivity"/>
</FrameLayout>