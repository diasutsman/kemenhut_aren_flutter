<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorPrimaryLight"
    tools:context="com.jayapack.wip.aren.fragment.ProfileFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/scroll_margin">
            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imgBg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_height_size"
                    android:src="@drawable/profilebg"
                    android:scaleType="fitXY"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:paddingLeft="@dimen/activity_vertical_margin"
                    android:paddingRight="@dimen/activity_vertical_margin"
                    android:orientation="horizontal">

                    <com.jayapack.wip.aren.classes.RoundedImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="@dimen/round_photo_size"
                        android:layout_height="@dimen/round_photo_size"
                        android:scaleType="centerCrop"
                        android:src="@drawable/default_user_icon" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginLeft="@dimen/card_margin_side"
                            android:layout_weight="1"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/lrger_font_size"/>
                        <TextView
                            android:id="@+id/txtRole"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginLeft="@dimen/card_margin_side"
                            android:layout_weight="1"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/tab_font_size"/>
                    </LinearLayout>


                    <Button
                        android:id="@+id/btnLogin"
                        android:layout_width="@dimen/profile_btn_width"
                        android:layout_height="@dimen/profile_btn_height"
                        android:padding="@dimen/small_padding"
                        android:text="@string/login_btn"
                        android:layout_marginRight="@dimen/card_label_padding"
                        android:textColor="@android:color/white"
                        android:textAllCaps="false"
                        android:layout_gravity="center_vertical|right"
                        android:background="@drawable/rounded_orange"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/llStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtFinished"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="@dimen/small_padding"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"/>
                    <View
                        android:layout_width="2dp"
                        android:layout_height="@dimen/lrger_font_size"
                        android:background="@drawable/bordered_box_white"
                        android:layout_marginTop="@dimen/button_margin"
                        />
                    <TextView
                        android:id="@+id/txtProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:padding="@dimen/small_padding"
                        android:textColor="@android:color/white"
                        android:textStyle="bold" />
                </LinearLayout>


            </FrameLayout>
            <LinearLayout
                android:id="@+id/llAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/border_set"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btInvHist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/small_margin_bottom"
                    android:background="@drawable/selector_tap"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:src="@drawable/icon_pick_hist"
                        android:layout_width="@dimen/deals_photo_size"
                        android:layout_height="@dimen/deals_photo_size"
                        android:layout_marginBottom="@dimen/button_margin"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/small_font"
                        android:textColor="@android:color/black"
                        android:gravity="center_horizontal"
                        android:text="@string/my_report"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/small_margin_bottom"
                    android:background="@drawable/selector_tap"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:src="@drawable/account_icon"
                        android:layout_width="@dimen/deals_photo_size"
                        android:layout_height="@dimen/deals_photo_size"
                        android:layout_marginBottom="@dimen/button_margin"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/small_font"
                        android:textColor="@android:color/black"
                        android:gravity="center_horizontal"
                        android:text="Account"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btSalesHist"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/small_margin_bottom"
                    android:background="@drawable/selector_tap"
                    android:gravity="center_horizontal"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:src="@drawable/icon_pm"
                        android:layout_width="@dimen/deals_photo_size"
                        android:layout_height="@dimen/deals_photo_size"
                        android:layout_marginBottom="@dimen/button_margin"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/small_font"
                        android:textColor="@android:color/black"
                        android:gravity="center_horizontal"
                        android:text="@string/my_performance"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/btnTerms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/small_margin_bottom"
                    android:background="@drawable/selector_tap"
                    android:orientation="horizontal">

                    <ImageView
                        android:src="@drawable/logo"
                        android:layout_width="@dimen/deals_photo_size"
                        android:layout_height="@dimen/deals_photo_size" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingLeft="@dimen/activity_vertical_margin"
                        android:paddingRight="@dimen/bottom_bar_padding"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/label_font_size"
                            android:textColor="@android:color/black"
                            android:text="@string/terms_condition"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/terms_text"/>
                    </LinearLayout>

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btnAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/small_margin_bottom"
                    android:background="@drawable/selector_tap"
                    android:orientation="horizontal">

                    <ImageView
                        android:src="@drawable/rounded_logo"
                        android:layout_width="@dimen/deals_photo_size"
                        android:layout_height="@dimen/deals_photo_size" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingLeft="@dimen/activity_vertical_margin"
                        android:paddingRight="@dimen/bottom_bar_padding"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/label_font_size"
                            android:textColor="@android:color/black"
                            android:text="@string/about_viva"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_text"/>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
