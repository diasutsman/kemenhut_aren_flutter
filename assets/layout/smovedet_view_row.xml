<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/border_set"
    android:descendantFocusability = "blocksDescendants"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/small_padding"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="18dp"
                android:gravity="center"
                android:textColor="@android:color/black"
                android:text="No."/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txtKodeLot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="18dp"
                android:paddingLeft="@dimen/small_padding"
                android:textColor="@android:color/black"
                android:textSize="@dimen/small_font_size"
                android:text="Kode Lot"/>
            <TextView
                android:id="@+id/txtNamaBarang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="18dp"
                android:paddingLeft="@dimen/small_padding"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:text="Nama Barang"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txtProdDt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="18dp"
                android:paddingLeft="@dimen/small_padding"
                android:textStyle="bold"
                android:textSize="11dp"
                android:textColor="@android:color/black"
                android:text="Kriteria"/>
            <TextView
                android:id="@+id/txtExpired"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="18dp"
                android:paddingLeft="@dimen/small_padding"
                android:textSize="11dp"
                android:textColor="@android:color/black"
                android:text="Expired"/>

        </LinearLayout>
        <TextView
            android:id="@+id/txtQty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:gravity="center"
            android:textSize="@dimen/item_desc_size"
            android:textColor="@android:color/black"
            android:text="100 PCS"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txtLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="18dp"
                android:textSize="10dp"
                android:paddingLeft="@dimen/small_padding"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@android:color/black"
                android:text="Kriteria"/>
            <TextView
                android:id="@+id/txtPallet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="6"
                android:gravity="center"
                android:textSize="@dimen/item_desc_size"
                android:textColor="@android:color/black"
                android:text="Pallet 1"/>

        </LinearLayout>

    </LinearLayout>
</LinearLayout>
