<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.FinishingActivity">

    <include
        layout="@layout/no_connectivity"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:textStyle="bold"
                            android:layout_weight="4"
                            android:text="@string/spk_no"/>

                        <TextView
                            android:id="@+id/txtSPKNo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:textSize="@dimen/tab_value_size"
                            android:fontFamily="Calibri"
                            android:layout_weight="2" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="4"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:text="@string/order_name" />

                    <TextView
                        android:id="@+id/txtOrderInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:textSize="@dimen/tab_value_size"
                        android:fontFamily="Calibri"
                        android:layout_weight="2" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="4"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:text="@string/nama_process" />

                    <TextView
                        android:id="@+id/txtProcessNm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:layout_weight="2"
                        android:fontFamily="Calibri"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/tab_value_size" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llExecutor2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:layout_weight="4"
                            android:text="@string/executor"
                            android:textColor="@android:color/black"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtExecutor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:layout_weight="2"
                            android:fontFamily="Calibri"
                            android:textColor="@android:color/black"
                            android:textSize="@dimen/tab_value_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtExecutorNm"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:textSize="@dimen/tab_value_size"
                            android:fontFamily="Calibri"
                            android:layout_weight="2" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llExecutor2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:layout_weight="4"
                            android:text="@string/jenis_pekerjaan"
                            android:textColor="@android:color/black"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spnJob"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:editable="false"
                            android:gravity="left"
                            android:hint="SKU.."
                            android:padding="@dimen/card_padding"
                            android:textSize="@dimen/tab_value_size" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_set"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:layout_weight="2"
                        android:text="@string/notes"
                        android:textColor="@android:color/black"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/txtNotes"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_weight="1"
                        android:editable="false"
                        android:gravity="left"
                        android:hint="Masukkan Catatan.."
                        android:inputType="textMultiLine"
                        android:padding="@dimen/card_padding"
                        android:textSize="@dimen/tab_value_size" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_set"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:layout_weight="2"
                        android:text="@string/attachment"
                        android:textColor="@android:color/black"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/btUploadImg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tiny_margin"
                        android:background="@drawable/border_set"
                        android:orientation="horizontal"
                        android:padding="@dimen/card_label_padding">

                        <ImageButton
                            android:layout_width="@dimen/btnattach_size"
                            android:layout_height="@dimen/btnattach_size"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/rounded_btn"
                            android:padding="@dimen/small_padding"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_action_add" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/card_padding"
                            android:text="@string/add_attachment" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llImg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_padding"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal"
                    android:padding="@dimen/small_margin_bottom"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/imgPaid"
                        android:layout_width="@dimen/attach_doc_size"
                        android:layout_height="@dimen/attach_doc_size"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/activity_vertical_margin"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_action_picture_holo" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtAttachment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:layout_weight="1"
                            android:padding="@dimen/card_padding"
                            android:text="@string/add_attachment" />

                        <ImageButton
                            android:id="@+id/btRemove"
                            android:layout_width="@dimen/btnattach_size"
                            android:layout_height="@dimen/btnattach_size"
                            android:layout_gravity="center_vertical|right"
                            android:background="@drawable/rounded_remove"
                            android:padding="@dimen/small_padding"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_action_cancel" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_label_padding"
                        android:padding="@dimen/small_padding"
                        android:background="@color/colorGray"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="6"
                            android:visibility="gone"
                            android:gravity="center"
                            android:textColor="@color/colorDarkOrange"
                            android:textStyle="bold"
                            android:text="@string/jenis_pekerjaan"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="4"
                            android:paddingLeft="@dimen/small_padding"
                            android:textColor="@color/colorDarkOrange"
                            android:textStyle="bold"
                            android:text="@string/pic"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="8"
                            android:gravity="center"
                            android:textColor="@color/colorDarkOrange"
                            android:textStyle="bold"
                            android:text="@string/qty"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border_set"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:layout_gravity="center"
                            android:src="@drawable/no_data" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/card_padding"
                            android:text="@string/no_data"
                            android:textColor="@android:color/black" />
                    </LinearLayout>

                    <com.jayapack.wip.aren.classes.EchancedGridView
                        xmlns:ptr="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/listItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:descendantFocusability="afterDescendants"
                        android:numColumns="1"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:scrollbars="vertical"
                        android:stretchMode="columnWidth"
                        ptr:ptrMode="both" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:layout_weight="2"
                        android:text="@string/broken_num"
                        android:textColor="@android:color/black"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/txtBrokenNum"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:editable="false"
                        android:gravity="left"
                        android:hint="Masukkan Qty Rusak.."
                        android:text="0"
                        android:inputType="number"
                        android:padding="@dimen/card_padding"
                        android:textSize="@dimen/tab_value_size" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:layout_weight="2"
                        android:text="@string/missing_num"
                        android:textColor="@android:color/black"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/txtMissingNum"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:editable="false"
                        android:gravity="left"
                        android:hint="Masukkan Qty Hilang.."
                        android:inputType="number"
                        android:text="0"
                        android:padding="@dimen/card_padding"
                        android:textSize="@dimen/tab_value_size" />

                </LinearLayout>
            </LinearLayout>


        </ScrollView>

        <LinearLayout
            android:id="@+id/pnlOperation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/user_box"
            android:orientation="vertical">
            <Button
                android:id="@+id/btConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/card_padding"
                android:layout_marginRight="@dimen/card_padding"
                android:layout_marginBottom="@dimen/card_label_padding"
                android:layout_marginTop="@dimen/card_label_padding"
                android:background="@drawable/rounded_green"
                android:drawableLeft="@drawable/ic_action_edit_white"
                android:paddingLeft="@dimen/card_padding"
                android:paddingRight="@dimen/small_padding"
                android:text="@string/save_data"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="@dimen/lrg_font_size"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>