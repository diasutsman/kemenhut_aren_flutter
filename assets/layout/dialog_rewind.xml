<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/small_padding"
            android:background="@color/colorDarkRed"
            android:orientation="horizontal">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="9"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:paddingLeft="@dimen/small_padding"
                android:text="@string/dialog_action"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnMovePutAway"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:background="@drawable/selector_rounded_btn"
            android:textColor="@color/selector_link"
            android:layout_margin="@dimen/card_label_padding"
            android:text="@string/pindah_barang" />

        <Button
            android:id="@+id/btnMoveStockOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/selector_rounded_btn"
            android:textColor="@color/selector_link"
            android:layout_marginRight="@dimen/card_label_padding"
            android:layout_marginLeft="@dimen/card_label_padding"
            android:textStyle="bold"
            android:text="@string/move_stock_out" />
    </LinearLayout>

</LinearLayout>