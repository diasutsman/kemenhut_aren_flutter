                        android:fontFamily="Calibri"
                        android:layout_weight="2" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="4"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:text="@string/deadline" />

                    <TextView
                        android:id="@+id/txtDeadline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:textSize="@dimen/tab_value_size"
                        android:fontFamily="Calibri"
                        android:layout_weight="2" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="4"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:text="@string/stats" />

                    <TextView
                        android:id="@+id/txtStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:textSize="@dimen/tab_value_size"
                        android:fontFamily="Calibri"
                        android:layout_weight="2" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/card_padding"
                    android:visibility="gone"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="4"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:text="@string/time_spent" />

                    <TextView
                        android:id="@+id/txtTimeSpent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:textSize="@dimen/tab_value_size"
                        android:fontFamily="Calibri"
                        android:layout_weight="2" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:background="@drawable/border_set"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="4"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:text="@string/brief_info" />

                    <TextView
                        android:id="@+id/txtBriefInfo"
                        android:layout_marginTop="@dimen/card_label_padding"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:textSize="@dimen/tab_value_size"
                        android:fontFamily="Calibri"
                        android:layout_weight="2" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:visibility="gone"
                    android:layout_height="500dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/activity_vertical_margin"
                        android:textColor="@color/colorRed"
                        android:paddingLeft="@dimen/card_padding"
                        android:textStyle="bold|italic"
                        android:text="@string/detail_petunjuk_kerja" />

                    <WebView
                        android:id="@+id/wvInfo"
                        android:layout_width="match_parent"
                        android:layout_height="820dp"
                        android:layout_marginTop="@dimen/card_label_padding" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llStrukan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/small_padding"
                        android:layout_marginTop="@dimen/activity_vertical_margin"
                        android:background="@color/colorGray"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="@dimen/small_padding"
                            android:textColor="@color/colorDarkOrange"
                            android:textStyle="bold"
                            android:text="#"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:textColor="@color/colorDarkOrange"
                            android:textStyle="bold"
                            android:text="@string/jenis_kertas"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:gravity="center"
                            android:textColor="@color/colorDarkOrange"
                            android:textStyle="bold"
                            android:text="@string/qty"/>
                    </LinearLayout>

                    <com.jayapack.wip.aren.classes.EchancedGridView
                        android:id="@+id/listItem"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="vertical" />
                </LinearLayout>
            </LinearLayout>


        </ScrollView>
        <LinearLayout
            android:id="@+id/pnlOperation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/user_box"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btReportProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_rounded_btn"
                android:layout_marginTop="@dimen/card_label_padding"
                android:layout_marginBottom="@dimen/card_label_padding"
                android:layout_marginLeft="@dimen/card_padding"
                android:layout_marginRight="@dimen/card_padding"
                android:textColor="@android:color/white"
                android:drawableLeft="@drawable/ic_action_edit_white"
                android:paddingLeft="@dimen/card_padding"
                android:paddingRight="@dimen/small_padding"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="@dimen/lrg_font_size"
                android:text="@string/report_progress"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>