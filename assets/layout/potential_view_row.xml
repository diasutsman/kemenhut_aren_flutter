<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/selector_basic"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorDarkRed"
        android:visibility="gone"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtKodePallet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:paddingLeft="@dimen/small_padding"
            android:text="@string/kode_pallet"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/profile_margin_bottom">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/deals_photo_size"
                android:layout_height="@dimen/deals_photo_size"
                android:layout_gravity="top"
                android:src="@drawable/icon_box"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/card_padding"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txtKodeLot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorPrimaryDark"
                android:textAllCaps="true"
                android:textSize="@dimen/small_font_size" />
            <TextView
                android:id="@+id/txtStockNm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorPrimaryDark"
                android:textAllCaps="true"
                android:textSize="@dimen/medium_font_size" />
            <TextView
                android:id="@+id/txtExpired"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/tiny_margin"
                android:textSize="@dimen/small_font_size" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/card_padding"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txtKriteria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorPrimaryDark"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="@dimen/medium_font_size" />

            <TextView
                android:id="@+id/txtMinDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:background="@drawable/bordered_box_red"
                android:layout_weight="1"
                android:gravity="center"
                android:text="-1 days"
                android:textStyle="bold"
                android:padding="@dimen/mini_padding"
                android:textSize="@dimen/small_font" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/card_padding"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txtQtyM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorPrimaryDark"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="@dimen/medium_font_size" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
