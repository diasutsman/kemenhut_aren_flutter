<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/small_padding"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/lblReportDt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:textSize="@dimen/item_desc_size"
            android:paddingLeft="@dimen/small_padding"
            android:textColor="@android:color/black"
            android:text="@string/input_date"/>
        <TextView
            android:id="@+id/lblProgressNm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:textSize="@dimen/item_desc_size"
            android:gravity="center"
            android:textColor="@android:color/black"
            android:text="@string/spk_no"/>
        <TextView
            android:id="@+id/lblQty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:textSize="@dimen/small_font"
            android:gravity="center"
            android:textColor="@android:color/black"
            android:text="@string/qty_s"/>
        <TextView
            android:id="@+id/lblOutsource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="7"
            android:gravity="center"
            android:textSize="@dimen/item_desc_size"
            android:textColor="@android:color/black"
            android:text="@string/status"/>
    </LinearLayout>

</LinearLayout>