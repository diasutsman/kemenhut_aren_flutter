<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/small_padding"
        android:orientation="horizontal"
        tools:ignore="MissingConstraints">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="18dp"
                android:gravity="center"
                android:textColor="@android:color/black"
                android:text="No."/>

            <ImageView
                android:id="@+id/btRemove"
                android:layout_width="@dimen/mini_icon_size"
                android:layout_height="@dimen/mini_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/remove_icon" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="7"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txtNamaBarang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="18dp"
                android:paddingLeft="@dimen/small_padding"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:text="Nama Barang"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txtKodeBrg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/small_padding"
                    android:textSize="@dimen/small_font_size"
                    android:textColor="@android:color/black"
                    android:text="Kode :"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/txtLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="8"
            android:textColor="@android:color/black"
            android:text="-"/>
        <TextView
            android:id="@+id/txtQty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="8"
            android:gravity="center"
            android:textSize="@dimen/item_desc_size"
            android:textColor="@android:color/black"
            android:text="1500 PCS"/>

        <TextView
            android:id="@+id/txtTakenNum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="9"
            android:gravity="center"
            android:textSize="@dimen/item_desc_size"
            android:textColor="@android:color/black"
            android:text="0"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>