<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/selector_tap"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/profile_margin_bottom">
        <ImageView
            android:layout_width="@dimen/deals_photo_size"
            android:layout_height="@dimen/deals_photo_size"
            android:layout_gravity="top"
            android:src="@drawable/icon_scroll"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/card_padding"
            android:layout_marginRight="@dimen/card_label_padding"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txtNoFaktur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorPrimaryDark"
                android:textAllCaps="true"
                android:textSize="@dimen/label_font_size" />
            <TextView
                android:id="@+id/txtTgl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tiny_margin"
                android:textSize="@dimen/small_font_size" />

        </LinearLayout>
        <TextView
            android:id="@+id/txtJmlItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorPrimaryDark"
            android:layout_weight="2"
            android:text="@string/jml_item"
            android:textAlignment="center"
            android:textSize="@dimen/medium_font_size" />
    </LinearLayout>
</LinearLayout>
