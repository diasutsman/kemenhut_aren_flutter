<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/selector_tap"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/card_padding"
        android:orientation="horizontal">

        <com.jayapack.wip.aren.classes.RoundedImageView
            android:id="@+id/imgNotif"
            android:layout_width="@dimen/img_photo_size"
            android:layout_height="@dimen/img_photo_size"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="@dimen/card_padding">

            <TextView
                android:id="@+id/txtNotifTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/label_value_size"
                android:textColor="@android:color/black"
                android:layout_marginBottom="@dimen/small_padding_bottom"
                android:text="Garansi Harga TERMURAH"/>

            <TextView
                android:id="@+id/txtNotifDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/item_desc_size"
                android:textColor="@color/colorDarkSilver"
                android:layout_marginBottom="@dimen/small_padding_bottom"
                android:text="Membeli barang - barang dan seluruh material yang diperlukan di dalam proyek pembangaunan pada tahapan pertama dalam proses pembangunan"/>


            <TextView
                    android:id="@+id/txtNotifDt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/small_font_size"
                    android:layout_weight="3"
                    android:textColor="@color/colorDarkGray"
                    android:drawableLeft="@drawable/ic_action_clock"
                    android:gravity="center_vertical|left"
                    android:text=" 21 Jan 2017 15:00"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>