<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/frameProduct"
    tools:context=".fragment.ProductFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_set"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:layout_weight="2"
                        android:text="Produk apa yang laku di tempat Anda dan harga berapa?"
                        android:textColor="@android:color/black"
                        android:textStyle="bold" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <View
                            android:layout_weight="1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                        <Button
                            android:id="@+id/btTambahProduct"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/card_label_padding"
                            android:layout_marginTop="@dimen/card_label_padding"
                            android:background="@drawable/rounded_green"
                            android:drawableLeft="@drawable/ic_action_add"
                            android:paddingLeft="@dimen/card_padding"
                            android:paddingRight="@dimen/card_padding"
                            android:text="Tambah"
                            android:textAllCaps="false"
                            android:layout_weight="2"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/label_value_size" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_label_padding"
                        android:background="@color/colorGray"
                        android:orientation="horizontal"
                        android:padding="@dimen/small_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="6"
                            android:gravity="center"
                            android:text="Product Name"
                            android:textColor="@color/colorDarkOrange"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="6"
                            android:paddingLeft="@dimen/small_padding"
                            android:text="Price"
                            android:textColor="@color/colorDarkOrange"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="6"
                            android:gravity="center"
                            android:text="Satuan"
                            android:textColor="@color/colorDarkOrange"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border_set"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:layout_gravity="center"
                            android:src="@drawable/no_data" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/card_padding"
                            android:text="@string/no_data"
                            android:textColor="@android:color/black" />
                    </LinearLayout>

                    <com.jayapack.wip.aren.classes.EchancedGridView xmlns:ptr="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/listItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:descendantFocusability="afterDescendants"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:numColumns="1"
                        android:scrollbars="vertical"
                        android:stretchMode="columnWidth"
                        ptr:ptrMode="both" />

                </LinearLayout>



            </LinearLayout>


        </ScrollView>

    </LinearLayout>

</FrameLayout>