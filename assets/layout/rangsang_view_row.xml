<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/border_set"
    android:descendantFocusability = "blocksDescendants"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/float_margin"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tvTgl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:gravity="center"
            android:text="Tanggal" />

        <TextView
            android:id="@+id/tvIris"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:paddingLeft="@dimen/small_padding"
            android:text="Diiris (cm)" />

        <TextView
            android:id="@+id/tvLama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:gravity="center"
            android:text="Lama Nira"  />

        <TextView
            android:id="@+id/tvTainaKete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:gravity="center"
            android:text="Taina Kete" />

        <TextView
            android:id="@+id/tvTainaRara"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:gravity="center"
            android:text="Taina Rara" />

        <TextView
            android:id="@+id/tvSimewu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:gravity="center"
            android:text="Simewu/Ginerez" />

        <ImageView
            android:id="@+id/btRemove"
            android:layout_width="@dimen/small_icon_size"
            android:layout_height="@dimen/small_icon_size"
            android:layout_gravity="center"
            android:src="@drawable/remove_icon" />
    </LinearLayout>
</LinearLayout>
