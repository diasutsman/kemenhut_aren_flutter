<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".input.SpkDetailActivity">

    <include
        layout="@layout/no_connectivity"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/card_padding"
                        android:paddingLeft="@dimen/card_padding"
                        android:paddingRight="@dimen/card_padding"
                        android:paddingBottom="@dimen/tiny_margin"
                        android:background="@drawable/border_set"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@android:color/black"
                                android:layout_gravity="top"
                                android:textStyle="bold"
                                android:layout_weight="4"
                                android:text="@string/spk_no"/>

                            <TextView
                                android:id="@+id/txtSPKNo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@android:color/black"
                                android:layout_gravity="top"
                                android:textSize="@dimen/tab_value_size"
                                android:fontFamily="Calibri"
                                android:layout_weight="2" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/card_padding"
                        android:paddingLeft="@dimen/card_padding"
                        android:paddingRight="@dimen/card_padding"
                        android:paddingBottom="@dimen/tiny_margin"
                        android:background="@drawable/border_set"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="4"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:text="@string/spk_date" />

                        <TextView
                            android:id="@+id/txtSPKDt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:textSize="@dimen/tab_value_size"
                            android:fontFamily="Calibri"
                            android:layout_weight="2" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/card_padding"
                        android:paddingLeft="@dimen/card_padding"
                        android:paddingRight="@dimen/card_padding"
                        android:paddingBottom="@dimen/tiny_margin"
                        android:background="@drawable/border_set"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="4"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:text="@string/nama_cetakkan" />

                        <TextView
                            android:id="@+id/txtCustomer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:textSize="@dimen/tab_value_size"
                            android:fontFamily="Calibri"
                            android:layout_weight="2" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/card_padding"
                        android:paddingLeft="@dimen/card_padding"
                        android:paddingRight="@dimen/card_padding"
                        android:paddingBottom="@dimen/tiny_margin"
                        android:background="@drawable/border_set"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="4"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:text="@string/jml_order" />

                        <TextView
                            android:id="@+id/txtJmlOrder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:textSize="@dimen/tab_value_size"
                            android:fontFamily="Calibri"
                            android:layout_weight="2" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/card_padding"
                        android:paddingLeft="@dimen/card_padding"
                        android:paddingRight="@dimen/card_padding"
                        android:paddingBottom="@dimen/tiny_margin"
                        android:background="@drawable/border_set"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="4"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:text="@string/bahan_plano" />

                        <TextView
                            android:id="@+id/txtBahanPlano"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:textSize="@dimen/tab_value_size"
                            android:fontFamily="Calibri"
                            android:layout_weight="2" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/card_padding"
                        android:paddingLeft="@dimen/card_padding"
                        android:paddingRight="@dimen/card_padding"
                        android:paddingBottom="@dimen/tiny_margin"
                        android:background="@drawable/border_set"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="4"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:text="@string/jml_plano" />

                        <TextView
                            android:id="@+id/txtJmlPlano"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:textSize="@dimen/tab_value_size"
                            android:fontFamily="Calibri"
                            android:layout_weight="2" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/card_padding"
                        android:paddingLeft="@dimen/card_padding"
                        android:paddingRight="@dimen/card_padding"
                        android:paddingBottom="@dimen/tiny_margin"
                        android:background="@drawable/border_set"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="4"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:text="@string/ukuran_potong" />

                        <TextView
                            android:id="@+id/txtUkuranPotong"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:textSize="@dimen/tab_value_size"
                            android:fontFamily="Calibri"
                            android:layout_weight="2" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/card_padding"
                        android:paddingLeft="@dimen/card_padding"
                        android:paddingRight="@dimen/card_padding"
                        android:paddingBottom="@dimen/tiny_margin"
                        android:background="@drawable/border_set"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="4"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:text="@string/area_cetak" />

                        <TextView
                            android:id="@+id/txtAreaCetak"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:textSize="@dimen/tab_value_size"
                            android:fontFamily="Calibri"
                            android:layout_weight="2" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/card_padding"
                        android:paddingLeft="@dimen/card_padding"
                        android:paddingRight="@dimen/card_padding"
                        android:paddingBottom="@dimen/tiny_margin"
                        android:visibility="gone"
                        android:background="@drawable/border_set"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="4"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:text="@string/area_strukkan" />

                        <TextView
                            android:id="@+id/txtAreaStrukkan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:textSize="@dimen/tab_value_size"
                            android:fontFamily="Calibri"
                            android:layout_weight="2" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/card_padding"
                        android:paddingLeft="@dimen/card_padding"
                        android:paddingRight="@dimen/card_padding"
                        android:paddingBottom="@dimen/tiny_margin"
                        android:background="@drawable/border_set"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="4"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:text="@string/finishing_additional" />

                        <TextView
                            android:id="@+id/txtFinishing"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:textSize="@dimen/tab_value_size"
                            android:fontFamily="Calibri"
                            android:layout_weight="2" />

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/activity_vertical_margin"
                        android:textColor="@color/colorRed"
                        android:paddingLeft="@dimen/card_padding"
                        android:textStyle="bold"
                        android:text="@string/detail_petunjuk_kerja" />

                    <com.jayapack.wip.aren.classes.CustomWebView
                        android:id="@+id/wvSketsaPotong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_label_padding" />
                </LinearLayout>
            </LinearLayout>


        </ScrollView>
    </LinearLayout>
</FrameLayout>