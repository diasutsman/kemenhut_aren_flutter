<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".input.InventarisActivity">



    <include
        layout="@layout/no_connectivity"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tabGravity="fill"
                app:tabMode="fixed"
                app:tabTextAppearance="@style/CustomTabTextAppearance"
                app:tabIndicatorColor="@android:color/white"
                app:tabSelectedTextColor="@android:color/white"
                app:tabTextColor="@android:color/white" />

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <LinearLayout
            android:id="@+id/pnlOperation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/user_box"
            android:orientation="vertical">

            <Button
                android:id="@+id/btConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/card_padding"
                android:layout_marginRight="@dimen/card_padding"
                android:layout_marginBottom="@dimen/card_label_padding"
                android:layout_marginTop="@dimen/card_label_padding"
                android:background="@drawable/rounded_green"
                android:drawableLeft="@drawable/ic_action_edit_white"
                android:paddingLeft="@dimen/card_padding"
                android:paddingRight="@dimen/small_padding"
                android:text="@string/save_data"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="@dimen/lrg_font_size"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>



</FrameLayout>