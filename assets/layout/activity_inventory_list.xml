<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.jayapack.wip.aren.input.InventoryListActivity">

    <include
        layout="@layout/empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <include
        layout="@layout/no_connectivity"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        layout="@layout/loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingRight="@dimen/card_label_padding"
            android:paddingLeft="@dimen/card_label_padding"
            android:paddingTop="@dimen/small_padding_bottom"
            android:paddingBottom="@dimen/small_padding_bottom"
            android:layout_marginLeft="@dimen/small_padding"
            android:layout_marginRight="@dimen/small_padding"
            android:layout_marginTop="@dimen/small_padding_bottom"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/tab_value_size"
                android:textColor="@android:color/black"
                android:layout_gravity="center_vertical"
                android:textStyle="bold"
                android:text="@string/tgl_spk" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/txtStartDt"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="@dimen/card_padding"
                    android:gravity="right"
                    android:textSize="@dimen/medium_font_size"
                    android:editable="false"
                    android:hint="Start.."/>
                <ImageButton
                    android:id="@+id/btChooseStartDt"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/btnbrowse_size"
                    android:padding="@dimen/tiny_padding"
                    android:layout_weight="3"
                    android:scaleType="fitCenter"
                    android:background="@drawable/rounded_btn_press"
                    android:src="@drawable/ic_action_calendar_month"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/txtEndDt"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="@dimen/card_padding"
                    android:gravity="right"
                    android:textSize="@dimen/medium_font_size"
                    android:editable="false"
                    android:hint="End.."/>
                <ImageButton
                    android:id="@+id/btChooseEndDt"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/btnbrowse_size"
                    android:layout_weight="3"
                    android:padding="@dimen/tiny_padding"
                    android:scaleType="fitCenter"
                    android:background="@drawable/rounded_btn_press"
                    android:src="@drawable/ic_action_calendar_month"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingRight="@dimen/card_label_padding"
            android:paddingLeft="@dimen/card_label_padding"
            android:paddingTop="@dimen/small_padding_bottom"
            android:paddingBottom="@dimen/small_padding_bottom"
            android:layout_marginLeft="@dimen/small_padding"
            android:layout_marginRight="@dimen/small_padding"
            android:layout_marginTop="@dimen/small_padding_bottom"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/tab_value_size"
                android:textColor="@android:color/black"
                android:layout_gravity="center_vertical"
                android:textStyle="bold"
                android:text="@string/spk_no" />

            <pl.utkala.searchablespinner.SearchableSpinner
                android:id="@+id/cbSPK"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                app:showHint="true"
                android:autofillHints="Pilih No. SPK"
                android:layout_weight="2"
                android:textSize="@dimen/tab_value_size"
                android:layout_gravity="top"
                android:fontFamily="Calibri" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingRight="@dimen/card_label_padding"
            android:paddingLeft="@dimen/card_label_padding"
            android:paddingTop="@dimen/small_padding_bottom"
            android:paddingBottom="@dimen/small_padding_bottom"
            android:layout_marginLeft="@dimen/small_padding"
            android:layout_marginRight="@dimen/small_padding"
            android:layout_marginTop="@dimen/small_padding_bottom"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/tab_value_size"
                android:textColor="@android:color/black"
                android:layout_gravity="center_vertical"
                android:textStyle="bold"
                android:text="@string/progress_name" />

            <pl.utkala.searchablespinner.SearchableSpinner
                android:id="@+id/cbProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:layout_weight="2"
                android:textSize="@dimen/tab_value_size"
                android:layout_gravity="top"
                android:fontFamily="Calibri" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/row_cetak"
            android:visibility="gone"
            android:paddingRight="@dimen/card_label_padding"
            android:paddingLeft="@dimen/card_label_padding"
            android:paddingTop="@dimen/small_padding_bottom"
            android:paddingBottom="@dimen/small_padding_bottom"
            android:layout_marginLeft="@dimen/small_padding"
            android:layout_marginRight="@dimen/small_padding"
            android:layout_marginTop="@dimen/small_padding_bottom"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/tab_value_size"
                android:textColor="@android:color/black"
                android:layout_gravity="center_vertical"
                android:textStyle="bold"
                android:text="@string/mesin_cetak" />

            <pl.utkala.searchablespinner.SearchableSpinner
                android:id="@+id/cbMachine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:layout_weight="2"
                android:textSize="@dimen/tab_value_size"
                android:layout_gravity="top"
                android:fontFamily="Calibri" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/row_pond"
            android:visibility="gone"
            android:paddingRight="@dimen/card_label_padding"
            android:paddingLeft="@dimen/card_label_padding"
            android:paddingTop="@dimen/small_padding_bottom"
            android:paddingBottom="@dimen/small_padding_bottom"
            android:layout_marginLeft="@dimen/small_padding"
            android:layout_marginRight="@dimen/small_padding"
            android:layout_marginTop="@dimen/small_padding_bottom"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/tab_value_size"
                android:textColor="@android:color/black"
                android:layout_gravity="center_vertical"
                android:textStyle="bold"
                android:text="@string/mesin_pond" />

            <pl.utkala.searchablespinner.SearchableSpinner
                android:id="@+id/cbPond"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:layout_weight="2"
                android:textSize="@dimen/tab_value_size"
                android:layout_gravity="top"
                android:fontFamily="Calibri" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeTrans"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/small_padding"
                    android:background="@color/colorGray"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:paddingLeft="@dimen/small_padding"
                        android:textColor="@color/colorDarkOrange"
                        android:textStyle="bold"
                        android:text="@string/start"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="6"
                        android:gravity="center"
                        android:textColor="@color/colorDarkOrange"
                        android:textStyle="bold"
                        android:text="@string/spk_no"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="6"
                        android:gravity="center"
                        android:textColor="@color/colorDarkOrange"
                        android:textStyle="bold"
                        android:text="@string/done_qty"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:gravity="center"
                        android:textColor="@color/colorDarkOrange"
                        android:textStyle="bold"
                        android:text="@string/status"/>
                </LinearLayout>

                <com.jayapack.wip.aren.classes.StatefulRecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical" />
            </LinearLayout>



        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>