<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".input.PerformanceActivity">

    <include
        layout="@layout/no_connectivity"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingRight="@dimen/card_label_padding"
                android:paddingLeft="@dimen/card_label_padding"
                android:paddingTop="@dimen/small_padding_bottom"
                android:paddingBottom="@dimen/small_padding_bottom"
                android:layout_marginLeft="@dimen/small_padding"
                android:layout_marginRight="@dimen/small_padding"
                android:layout_marginTop="@dimen/small_padding_bottom"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/tab_value_size"
                    android:textColor="@android:color/black"
                    android:layout_gravity="center_vertical"
                    android:textStyle="bold"
                    android:text="@string/deadline" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/txtStartDt"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="@dimen/card_padding"
                        android:gravity="right"
                        android:textSize="@dimen/medium_font_size"
                        android:editable="false"
                        android:hint="Start.."/>
                    <ImageButton
                        android:id="@+id/btChooseStartDt"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/btnbrowse_size"
                        android:padding="@dimen/tiny_padding"
                        android:layout_weight="3"
                        android:scaleType="fitCenter"
                        android:background="@drawable/rounded_btn_press"
                        android:src="@drawable/ic_action_calendar_month"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/txtEndDt"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="@dimen/card_padding"
                        android:gravity="right"
                        android:textSize="@dimen/medium_font_size"
                        android:editable="false"
                        android:hint="End.."/>
                    <ImageButton
                        android:id="@+id/btChooseEndDt"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/btnbrowse_size"
                        android:layout_weight="3"
                        android:padding="@dimen/tiny_padding"
                        android:scaleType="fitCenter"
                        android:background="@drawable/rounded_btn_press"
                        android:src="@drawable/ic_action_calendar_month"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.jayapack.wip.aren.classes.CustomWebView
                    android:id="@+id/wvChart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/card_padding"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:text="@string/jml_task_handle" />

                    <TextView
                        android:id="@+id/txtJmlHandle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:textSize="@dimen/tab_value_size"
                        android:fontFamily="Calibri"
                        android:text="3"
                        android:layout_weight="2" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:text="@string/jml_task_done" />

                    <TextView
                        android:id="@+id/txtJmlFinish"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:textSize="@dimen/tab_value_size"
                        android:fontFamily="Calibri"
                        android:text="3"
                        android:layout_weight="2" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:text="@string/jml_qty_handle" />

                    <TextView
                        android:id="@+id/txtQtyHandle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:textSize="@dimen/tab_value_size"
                        android:fontFamily="Calibri"
                        android:text="120"
                        android:layout_weight="2" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:text="@string/jml_qty_done" />

                    <TextView
                        android:id="@+id/txtQtyDone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:textSize="@dimen/tab_value_size"
                        android:fontFamily="Calibri"
                        android:text="120"
                        android:layout_weight="2" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:text="@string/match_timeline" />

                    <TextView
                        android:id="@+id/txtJmlMatch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:textSize="@dimen/tab_value_size"
                        android:fontFamily="Calibri"
                        android:text="2"
                        android:layout_weight="2" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:text="@string/not_match_timeline" />

                    <TextView
                        android:id="@+id/txtNotMatch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:textSize="@dimen/tab_value_size"
                        android:fontFamily="Calibri"
                        android:text="1"
                        android:layout_weight="2" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:text="@string/success_rate" />

                    <TextView
                        android:id="@+id/txtSuccessRate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:textSize="@dimen/tab_value_size"
                        android:fontFamily="Calibri"
                        android:text="66.67%"
                        android:layout_weight="2" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:text="@string/max_delay" />

                    <TextView
                        android:id="@+id/txtMaxDelay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/black"
                        android:layout_gravity="top"
                        android:textSize="@dimen/tab_value_size"
                        android:fontFamily="Calibri"
                        android:layout_weight="2" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:textStyle="bold"
                            android:layout_weight="3"
                            android:text="@string/last_report_date"/>

                        <TextView
                            android:id="@+id/txtLastReportDt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:textSize="@dimen/tab_value_size"
                            android:fontFamily="Calibri"
                            android:text="2021"
                            android:layout_weight="2" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingLeft="@dimen/card_padding"
                    android:paddingRight="@dimen/card_padding"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:background="@drawable/border_set"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:textStyle="bold"
                            android:layout_weight="3"
                            android:text="@string/last_finish_date"/>

                        <TextView
                            android:id="@+id/txtLastFinishDt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/black"
                            android:layout_gravity="top"
                            android:textSize="@dimen/tab_value_size"
                            android:fontFamily="Calibri"
                            android:text="2021"
                            android:layout_weight="2" />
                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>


        </ScrollView>
    </LinearLayout>
</FrameLayout>