<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/border_set"
    android:descendantFocusability = "blocksDescendants"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/float_margin"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTglMulai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:gravity="center"
            android:text="Tgl Mulai"  />

        <TextView
            android:id="@+id/tvTglAkhir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:paddingLeft="@dimen/small_padding"
            android:text="Tgl Akhir"  />

        <TextView
            android:id="@+id/tvPanjang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:gravity="center"
            android:text="Panjang"  />

        <TextView
            android:id="@+id/tvDiameter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:gravity="center"
            android:text="Diameter"  />
        <TextView
            android:id="@+id/tvLama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:gravity="center"
            android:text="Lama"  />
        <TextView
            android:id="@+id/tvNiraPagi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:gravity="center"
            android:text="Nira Pagi"  />

        <TextView
            android:id="@+id/tvNiraSore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:gravity="center"
            android:text="Nira Sore"  />

        <TextView
            android:id="@+id/tvBrixPagi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:gravity="center"
            android:text="Brix Pagi"  />

        <TextView
            android:id="@+id/tvBrixSore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:gravity="center"
            android:text="Brix Sore"  />

        <ImageView
            android:id="@+id/btRemove"
            android:layout_width="@dimen/small_icon_size"
            android:layout_height="@dimen/small_icon_size"
            android:layout_gravity="center"
            android:src="@drawable/remove_icon" />
    </LinearLayout>
</LinearLayout>
