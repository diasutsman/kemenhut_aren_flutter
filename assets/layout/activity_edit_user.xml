<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_edit_user"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context="com.jayapack.wip.aren.account.EditUserActivity">

    <include
        layout="@layout/no_connectivity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/activity_vertical_margin">

            <LinearLayout
                android:id="@+id/llName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingBottom="@dimen/value_left_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/what_name"
                    android:layout_marginTop="@dimen/step_margin"
                    android:textStyle="bold"
                    android:gravity="center_horizontal"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/lrger_font_size"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/what_name_text"
                    android:layout_marginTop="@dimen/bottom_bar_padding_side"
                    android:gravity="center_horizontal"
                    android:textSize="@dimen/label_value_size"/>
                <EditText
                    android:id="@+id/txtName"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/card_label_padding"
                    android:layout_marginTop="@dimen/next2_margin"
                    android:background="@drawable/text_border"
                    android:hint="Masukkan nama anda.." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llIDCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingBottom="@dimen/value_left_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/what_idcard"
                    android:layout_marginTop="@dimen/step_margin"
                    android:textStyle="bold"
                    android:gravity="center_horizontal"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/lrger_font_size"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/what_idcard_text"
                    android:layout_marginTop="@dimen/bottom_bar_padding_side"
                    android:gravity="center_horizontal"
                    android:textSize="@dimen/label_value_size"/>
                <EditText
                    android:id="@+id/txtIDCard"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/card_label_padding"
                    android:layout_marginTop="@dimen/next2_margin"
                    android:background="@drawable/text_border"
                    android:hint="Masukkan nomor KTP anda.." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="@dimen/card_label_padding"
                android:paddingBottom="@dimen/value_left_padding">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/what_gender"
                    android:layout_marginTop="@dimen/step_margin"
                    android:textStyle="bold"
                    android:gravity="center_horizontal"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/lrger_font_size"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/what_gender_text"
                    android:layout_marginTop="@dimen/bottom_bar_padding_side"
                    android:gravity="center_horizontal"
                    android:textSize="@dimen/label_value_size"/>
                <Spinner
                    android:id="@+id/cbGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entries="@array/gender"
                    android:layout_marginTop="@dimen/activity_vertical_margin" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="@dimen/card_label_padding"
                android:paddingBottom="@dimen/value_left_padding">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/where_address"
                    android:layout_marginTop="@dimen/step_margin"
                    android:textStyle="bold"
                    android:gravity="center_horizontal"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/lrger_font_size"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/what_password_text"
                    android:layout_marginTop="@dimen/bottom_bar_padding_side"
                    android:gravity="center_horizontal"
                    android:textSize="@dimen/label_value_size"/>
                <EditText
                    android:id="@+id/txtAddress"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/textarea_height"
                    android:inputType="textMultiLine"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:hint="Masukkan alamat anda.."
                    android:background="@drawable/text_border"
                    android:padding="@dimen/card_label_padding"
                    android:gravity="top" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="@dimen/card_label_padding"
                android:paddingBottom="@dimen/value_left_padding">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/what_email"
                    android:layout_marginTop="@dimen/step_margin"
                    android:textStyle="bold"
                    android:gravity="center_horizontal"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/lrger_font_size"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/what_email_text"
                    android:layout_marginTop="@dimen/bottom_bar_padding_side"
                    android:gravity="center_horizontal"
                    android:textSize="@dimen/label_value_size"/>
                <EditText
                    android:id="@+id/txtEmail"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/next2_margin"
                    android:padding="@dimen/card_label_padding"
                    android:background="@drawable/text_border"
                    android:inputType="textEmailAddress"
                    android:textCursorDrawable="@null"
                    android:hint="@string/fill_your_email" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="@dimen/card_label_padding"
                android:paddingBottom="@dimen/value_left_padding">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/what_phone"
                    android:layout_marginTop="@dimen/step_margin"
                    android:textStyle="bold"
                    android:gravity="center_horizontal"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/lrger_font_size"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/what_phone_text"
                    android:layout_marginTop="@dimen/bottom_bar_padding_side"
                    android:gravity="center_horizontal"
                    android:textSize="@dimen/label_value_size"/>
                <EditText
                    android:id="@+id/txtPhone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/next2_margin"
                    android:padding="@dimen/card_label_padding"
                    android:background="@drawable/text_border"
                    android:inputType="phone"
                    android:textCursorDrawable="@null"
                    android:hint="@string/fill_your_phone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="@dimen/card_label_padding"
                android:paddingBottom="@dimen/value_left_padding">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/what_username"
                    android:layout_marginTop="@dimen/step_margin"
                    android:textStyle="bold"
                    android:gravity="center_horizontal"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/lrger_font_size"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/what_username_text"
                    android:layout_marginTop="@dimen/bottom_bar_padding_side"
                    android:gravity="center_horizontal"
                    android:textSize="@dimen/label_value_size"/>
                <EditText
                    android:id="@+id/txtUsername"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/next2_margin"
                    android:padding="@dimen/card_label_padding"
                    android:background="@drawable/text_border"
                    android:hint="@string/fill_your_username" />
            </LinearLayout>

            <Button
                android:id="@+id/btnUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_rounded_btn"
                android:layout_marginTop="@dimen/next2_margin"
                android:layout_marginLeft="@dimen/value_left_padding"
                android:layout_marginRight="@dimen/value_left_padding"
                android:textColor="@android:color/white"
                android:drawableLeft="@drawable/ic_action_edit_white"
                android:paddingLeft="@dimen/card_padding"
                android:paddingRight="@dimen/small_padding"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="@dimen/lrg_font_size"
                android:text="@string/change_data"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
