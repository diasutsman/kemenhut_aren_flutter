<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/border_set"
    android:descendantFocusability = "blocksDescendants"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/small_padding"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="18dp"
                android:gravity="center"
                android:textColor="@android:color/black"
                android:text="No."/>

            <ImageView
                android:id="@+id/btRemove"
                android:layout_width="@dimen/mini_icon_size"
                android:layout_height="@dimen/mini_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/remove_icon" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txtKodeLot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="18dp"
                android:paddingLeft="@dimen/small_padding"
                android:textColor="@android:color/black"
                android:textSize="@dimen/small_font_size"
                android:text="Kode Lot"/>
            <TextView
                android:id="@+id/txtNamaBarang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="18dp"
                android:paddingLeft="@dimen/small_padding"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:text="Nama Barang"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txtExpired"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/small_padding"
                    android:textSize="@dimen/small_font_size"
                    android:textColor="@android:color/black"
                    android:text="Expire:"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/txtKriteria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="7"
            android:textColor="@android:color/black"
            android:text="-"/>
        <TextView
            android:id="@+id/txtQty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="7"
            android:gravity="center"
            android:textSize="@dimen/item_desc_size"
            android:textColor="@android:color/black"
            android:text="(1500/10.2)"/>

        <Switch
            android:id="@+id/switchGood"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="8" />

        <CheckBox
            android:id="@+id/chkAdvance"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="8"/>
    </LinearLayout>
</LinearLayout>
